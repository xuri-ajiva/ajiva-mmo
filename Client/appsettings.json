{
  "ClientConfiguration": {
    "AutoConnect": true,
    "AutoConnectAddress": "udp://localhost:7777"
  },
  "Window": {
    "Width": 1920,
    "Height": 1080,
    "X": 100,
    "Y": 100,
    "Title": "Ajiva MMO Client",
    "Icon": "icon.png",
    "Resizable": true,
    "FullscreenBorderless": false,
    "VSync": false
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Thread",
      "Serilog.Enrichers.CallerInfo",
      "Serilog.Expressions"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Client.Renderer.Resources.ResourceLoader": "Verbose",
        "Client.Renderer.Resources.ModelHelper": "Error",
        "Client.Game.ClientGameLogic": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "path": "Logs/log.txt"
          //"outputTemplate": "{Timestamp:o}|{Level:u3}|({ThreadId}/{ThreadName})|{SourceContext}|{Message}|{Exception}{NewLine}"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} [{Level:u3}] ({SourceContext})] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Destructure": [
      {
        "Name": "ToMaximumDepth",
        "Args": {
          "maximumDestructuringDepth": 4
        }
      },
      {
        "Name": "ToMaximumStringLength",
        "Args": {
          "maximumStringLength": 100
        }
      },
      {
        "Name": "ToMaximumCollectionCount",
        "Args": {
          "maximumCollectionCount": 10
        }
      }
    ]
  },
  "ShaderReloadManager": {
    "Enabled": true,
    "Path": "../Client.Renderer/Wgsl",
    "RequiredFiles": [
      "GlobalUsings.cs"
    ]
  },
  "PeriodicUpdater": {
    "None": "0:00:00.00"
  }
}
