<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <!--
                <PublishAot>true</PublishAot>
        -->
        <UserSecretsId>dotnet-client-9511fe38-fe70-4349-a053-26a89194eaf0</UserSecretsId>
        <NoDefaultLaunchSettingsFile>True</NoDefaultLaunchSettingsFile>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>Client</RootNamespace>
        <LangVersion>preview</LangVersion>
        <Features>InterceptorsPreview</Features>
        <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Microsoft.AspNetCore.Http.Generated;Client.Generated;System.Runtime.CompilerServices;Interception</InterceptorsPreviewNamespaces>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Composer" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="GlmSharp-netstandard"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp"/>
        <PackageReference Include="Microsoft.Extensions.Hosting"/>
        <PackageReference Include="Polly" />

        <PackageReference Include="Silk.NET.Maths"/>
        <PackageReference Include="Silk.NET.WebGPU"/>
        <PackageReference Include="Silk.NET.WebGPU.Native.WGPU"/>
        <PackageReference Include="Silk.NET.WebGPU.Extensions.Disposal"/>
        <PackageReference Include="NativeFileDialogExtendedSharp"/>

        <PackageReference Include="Silk.NET.Assimp"/>
        <PackageReference Include="SixLabors.ImageSharp"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Generators\InterceptionTraceGenerator\InterceptionTraceGenerator.csproj" OutputItemType="Analyzer" />
        <ProjectReference Include="..\Generators\WgslGenerator\WgslGenerator.csproj" OutputItemType="Analyzer" />
        <ProjectReference Include="..\Common\Common.csproj" />
        <ProjectReference Include="..\Libs\WebGPU-Wrappers-for-Silk.Net\Silk.NET.WebGPU.Extensions.ImGui\Silk.NET.WebGPU.Extensions.ImGui.csproj" />
    </ItemGroup>
</Project>
