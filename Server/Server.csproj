<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <PublishAot>true</PublishAot>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>preview</LangVersion>
        <Features>InterceptorsPreview</Features>
        <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Microsoft.AspNetCore.Http.Generated;Server;System.Runtime.CompilerServices;Interception</InterceptorsPreviewNamespaces>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="GlmSharp-netstandard" />
        <PackageReference Include="Mars.Life.Simulations" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="../Common/GlobalUsings.cs"/>
        <ProjectReference Include="..\Common\Common.csproj"/>
        <ProjectReference Include="..\Generators\InterceptionTraceGenerator\InterceptionTraceGenerator.csproj" OutputItemType="Analyzer"/>
    </ItemGroup>
</Project>
